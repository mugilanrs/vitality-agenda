# Required in production: long random string used to sign the login cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Admin login is "admin" + the suffix below (admin@india2026). Set this only to
# replace it with a custom password.
# ADMIN_PASSWORD=

# Optional: attendee passwords are "<first name><suffix>" (default shown).
# ATTENDEE_PASSWORD_SUFFIX=@india2026

# Contacts shown under the phone icon. One line of JSON; add or remove entries.
# role = what they do, name = who, phone = tap-to-call (include country code).
# On Vercel paste only the [...] part as the value of CONTACTS.
CONTACTS=[{"role":"Event coordinator","name":"Full Name","phone":"+91 90000 00000"},{"role":"Reception","name":"Front desk","phone":"+91 44 0000 0000"},{"role":"Transport","name":"Full Name","phone":"+91 90000 00001"}]

# Chennai airport pickup. Names and phones (include country code) for the three
# pickup people and three drivers; which attendee gets which is set in
# lib/server/arrivals.ts. Unset values show as "NA".
PICKUP_P1_NAME=
PICKUP_P1_PHONE=
PICKUP_P2_NAME=
PICKUP_P2_PHONE=
PICKUP_P3_NAME=
PICKUP_P3_PHONE=
DRIVER_D1_NAME=
DRIVER_D1_PHONE=
DRIVER_D2_NAME=
DRIVER_D2_PHONE=
DRIVER_D3_NAME=
DRIVER_D3_PHONE=
