# Required in production: long random string used to sign the login cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Admin login is "admin" + the suffix below (admin@event2026). Set this only to
# replace it with a custom password.
# ADMIN_PASSWORD=

# Optional: attendee passwords are "<first name><suffix>" (default shown).
# ATTENDEE_PASSWORD_SUFFIX=@event2026
